{
  "uid": "uiex_builder_connector",
  "type": "app",
  "config": {
    "description": "Lets UI Extension Builder show your real CRM records, properties and pipelines while you design cards. Read-only: it never changes your data.",
    "name": "UI Extension Builder",
    "distribution": "marketplace",
    "auth": {
      "type": "oauth",
      "redirectUrls": [
        "https://YOUR-DOMAIN/api/auth/callback"
      ],
      "requiredScopes": [
        "oauth",
        "crm.objects.contacts.read",
        "crm.objects.companies.read",
        "crm.objects.deals.read",
        "crm.schemas.contacts.read",
        "crm.schemas.companies.read",
        "crm.schemas.deals.read"
      ],
      "optionalScopes": [
        "crm.objects.tickets.read",
        "crm.schemas.tickets.read",
        "crm.objects.custom.read",
        "crm.schemas.custom.read",
        "crm.objects.owners.read",
        "crm.objects.line_items.read",
        "crm.objects.products.read",
        "crm.objects.quotes.read"
      ],
      "conditionallyRequiredScopes": []
    },
    "permittedUrls": {
      "fetch": [],
      "iframe": [],
      "img": []
    },
    "support": {
      "supportEmail": "support@example.com",
      "documentationUrl": "https://example.com/docs",
      "supportUrl": "https://example.com/support",
      "supportPhone": "+18005555555"
    }
  }
}
