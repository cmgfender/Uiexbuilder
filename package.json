{
  "name": "uiex-builder",
  "private": true,
  "version": "0.1.0",
  "description": "Visual drag-and-drop builder for HubSpot UI extensions (app cards, settings pages, app home).",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:full": "node scripts/dev.mjs --fake",
    "dev:vite": "vite",
    "build": "tsc -b && vite build && node scripts/build-server.mjs",
    "build:app": "tsc -b && vite build",
    "build:server": "node scripts/build-server.mjs",
    "start": "node --enable-source-maps dist-server/node.mjs",
    "start:demo": "node scripts/dev.mjs --fake --prod",
    "secret": "node scripts/generate-secret.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test"
  },
  "dependencies": {
    "immer": "^11.1.21",
    "jszip": "^3.10.2",
    "lucide-react": "^1.57.0",
    "nanoid": "^6.0.2",
    "prettier": "^3.9.10",
    "prism-react-renderer": "^2.4.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@hubspot/ui-extensions": "0.17.1",
    "@playwright/test": "1.56.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.2",
    "esbuild": "^0.28.2",
    "jsdom": "^29.1.1",
    "typescript": "~5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
