# UI Extension Builder - server settings ("Sign in with HubSpot").
# Copy to .env.local for local development (npm run dev), or enter these in your host's
# "Environment variables" screen (Render, Vercel, Docker, Cloudflare). Never commit real values.
# Full guide: docs/HOSTING.md

# The address people open in their browser, without a trailing slash.
# Render / Vercel / Railway / Fly fill this in automatically when it is empty.
APP_URL=http://localhost:5173

# From your HubSpot app: Development > Projects > your app > Auth tab.
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=

# At least 32 random characters. Keeps sign-in cookies private. Changing it signs everyone out.
# Make one: open /secret.html on your builder, or run `npm run secret`.
SESSION_SECRET=

# ---- Optional -------------------------------------------------------------------------------
# Scopes, separated by commas or spaces. Must match the scopes of your HubSpot app.
# HUBSPOT_SCOPES=oauth,crm.objects.contacts.read,crm.objects.companies.read,crm.objects.deals.read,crm.schemas.contacts.read,crm.schemas.companies.read,crm.schemas.deals.read
# HUBSPOT_OPTIONAL_SCOPES=crm.objects.tickets.read,crm.schemas.tickets.read,crm.objects.custom.read,crm.schemas.custom.read,crm.objects.owners.read,crm.objects.line_items.read,crm.objects.products.read,crm.objects.quotes.read

# HubSpot hosts. EU accounts: if sign-in fails, set HUBSPOT_APP_BASE=https://app-eu1.hubspot.com
# HUBSPOT_API_BASE=https://api.hubapi.com
# HUBSPOT_APP_BASE=https://app.hubspot.com

# Feature switches (default true).
# ENABLE_FETCH_PROXY=true
# ENABLE_DEPLOY=true

# Other sites allowed to call this connector (comma separated origins), e.g. a separately hosted builder.
# ALLOWED_ORIGINS=

# Recommended: the HubSpot account ids (hub ids) that may sign in and deploy, comma separated.
# Empty = any account that installs your HubSpot app.
# ALLOWED_PORTALS=12345678

# The private status page (/status): what happened with sign-ins, publishes and errors, in plain
# words. Only people signed in with HubSpot whose HubSpot login email is listed here can open it
# (comma separated). Nobody can until one of these is set.
# ADMIN_EMAILS=you@example.com
# Or: everyone signed in to these HubSpot accounts (account ids, comma separated).
# ADMIN_PORTALS=12345678

# Node server only (npm start / Docker).
# PORT=3000
# LOG_REQUESTS=true
# One "[event]" JSON line per sign-in, publish, refused request or browser error (default true).
# LOG_EVENTS=true
